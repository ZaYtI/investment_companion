      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Pas d\\'erreur API', () => pm.expect(body.status, body.message).to.not.equal('error'));",
              "pm.test('Des points sont renvoyés', () => pm.expect(body.values).to.be.an('array').that.is.not.empty);",
