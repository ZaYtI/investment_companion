    {
      "name": "5 · Recherche de symboles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Des résultats', () => pm.expect(body.data).to.be.an('array').that.is.not.empty);",
              "if (body.data) console.log(body.data.slice(0, 5).map(d => `${d.symbol} · ${d.instrument_name} · ${d.exchange} · ${d.instrument_type}`).join('\\n'));"
            ]
          }
        }
      ],
