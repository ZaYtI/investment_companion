{
  "info": {
    "name": "Investment Companion · Twelve Data (IC-04)",
    "description": "Tests de l'API Twelve Data pour l'issue #4.\n\nAvant de lancer : onglet Variables de la collection → mettre votre clé dans `apikey` (colonne Current value, qui n'est pas exportée ni partagée). Les résultats détaillés s'affichent dans la console Postman (View → Show Postman Console).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 · SPY hebdomadaire 2013",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Pas d\\'erreur API', () => pm.expect(body.status, body.message).to.not.equal('error'));",
              "pm.test('Des points sont renvoyés', () => pm.expect(body.values).to.be.an('array').that.is.not.empty);",
              "if (body.values) {",
              "  const first = body.values[0], last = body.values[body.values.length - 1];",
              "  console.log(`${body.meta.symbol} · ${body.values.length} points · du ${first.datetime} au ${last.datetime}`);",
              "  pm.test('Les prix arrivent en chaînes', () => pm.expect(first.close).to.be.a('string'));",
              "  pm.test('Au moins 50 points', () => pm.expect(body.values.length).to.be.at.least(50));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "description": "Chapitres 2 et 3 : série hebdomadaire. Sans outputsize, l'API ne renvoie que 30 points. end_date est exclusive.",
        "url": {
          "raw": "{{baseUrl}}/time_series?symbol=SPY&interval=1week&start_date=2013-01-01&end_date=2014-01-01&outputsize=5000&order=asc&apikey={{apikey}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "time_series"
          ],
          "query": [
            {
              "key": "symbol",
              "value": "SPY"
            },
            {
              "key": "interval",
              "value": "1week"
            },
            {
              "key": "start_date",
              "value": "2013-01-01"
            },
            {
              "key": "end_date",
              "value": "2014-01-01"
            },
            {
              "key": "outputsize",
              "value": "5000"
            },
            {
              "key": "order",
              "value": "asc"
            },
            {
              "key": "apikey",
              "value": "{{apikey}}"
            }
          ]
        }
      }
    },
