    {
      "name": "7 · Test du quota (à lancer 10 fois dans le Runner)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "console.log(`Itération ${pm.info.iteration + 1} · HTTP ${pm.response.code} · status=${body.status || 'ok'} · code=${body.code || '-'} · ${body.message || ''}`);",
              "pm.test('Réponse reçue', () => pm.response.to.have.status(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "description": "Lancer avec le Collection Runner sur cette seule requête, 10 itérations, délai 0. Observer à partir de quelle itération l'erreur apparaît, avec quel code HTTP et quel message.",
        "url": {
          "raw": "{{baseUrl}}/time_series?symbol=SPY&interval=1day&outputsize=1&apikey={{apikey}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
